# =============================================================================
# DONARIA BACKEND - Environment Variables
# =============================================================================
# Copy file ini ke .env dan isi sesuai environment Anda
# cp .env.example .env

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Port server (default: 3000)
PORT=3000

# Environment: development | production | test
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION (MySQL via XAMPP)
# =============================================================================

# Nama database MySQL
DB_NAME=donaria

# Username MySQL (default XAMPP: root)
DB_USER=root

# Password MySQL (default XAMPP: kosong)
DB_PASS=

# Host MySQL (default: localhost)
DB_HOST=localhost

# Port MySQL (default: 3306)
DB_PORT=3306

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Secret key untuk signing JWT token (GANTI DENGAN RANDOM STRING DI PRODUKSI!)
# Contoh generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this

# Masa berlaku token (default: 7 hari)
# Format: number + s/m/h/d (detik/menit/jam/hari)
JWT_EXPIRES_IN=7d

# =============================================================================
# TRIPAY PAYMENT GATEWAY
# =============================================================================
# Daftar di https://tripay.co.id untuk mendapatkan API keys

# API Key (dari dashboard Tripay)
TRIPAY_API_KEY=your-tripay-api-key

# Private Key (dari dashboard Tripay, JANGAN share!)
TRIPAY_PRIVATE_KEY=your-tripay-private-key

# Merchant Code (kode merchant Anda)
TRIPAY_MERCHANT_CODE=your-merchant-code

# Base URL Tripay
# Sandbox: https://tripay.co.id/api-sandbox
# Production: https://tripay.co.id/api
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Origins yang diizinkan (comma-separated)
# Contoh: http://localhost:5500,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:3000

# =============================================================================
# FRONTEND URL
# =============================================================================

# URL frontend untuk redirect setelah pembayaran
# Website: http://localhost:5500
FRONTEND_URL=http://localhost:5500
